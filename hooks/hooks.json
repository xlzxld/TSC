{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": ["${ZCODE_PLUGIN_ROOT}/scripts/structure_guard.py", "--from-hook"],
            "timeoutMs": 15000,
            "statusMessage": "TSC 结构门禁：检查刚改的文件"
          }
        ]
      }
    ]
  }
}
